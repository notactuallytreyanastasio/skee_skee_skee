# Deciduous: local database stays private, the shared graph is tracked
.deciduous/*
!.deciduous/config.toml
!.deciduous/graph.json
.build/
.swiftpm/
*.xcodeproj/
xcuserdata/
DerivedData/
.prs/
/out/

# DeepSeek key for the casino host: never committed. scripts/secrets.sh writes both.
.env
App/Secrets.xcconfig
